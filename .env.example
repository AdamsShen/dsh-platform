# 数据库（本地用 docker compose 起的 PG；生产替换为内网地址）
AO_DB_URL=postgresql://ao:ao@127.0.0.1:55433/ao

# 执行模式：1 = 仅 mock provider（不联网、不调模型）
AO_MOCK=1
# 执行器：langgraph | interpreter
AO_EXECUTOR=langgraph
# 执行池槽位（由容量报告实测后定）
AO_EXEC_SLOTS=24

# 会话签名密钥，生产必须覆盖
AO_SECRET=ao-dev-secret

# 事件触发入站令牌（P2-T18）：生产必填，留空时只在 AO_ENV=dev 放行
AO_EVENT_TOKEN=

# 创作面（P2-T11）
AO_UPLOADS_DIR=
AO_UPLOAD_MAX_MB=10
AO_PLANNER_SUMMARY_AFTER=20
AO_PLANNER_SUMMARY_BATCH=10
# 生成失败回退轮数：1 表示不重试，默认 3
AO_AUTHORING_REPAIR_ROUNDS=3

# DSH（AO_MOCK=0 时必填）
DEEPSEEK_API_KEY=
# 留空则用运行时默认（deepseek-v4-flash）
AO_DSH_MODEL=
AO_DSH_PERMISSION_MODE=workspace-write

# 网关（AO_MOCK=0 时必填）
AO_GATEWAY_URL=
AO_GATEWAY_MASTER_KEY=

# 沙箱：bwrap | nsjail | none（none 仅本地开发）
AO_SANDBOX=none
AO_ENV=dev
# 受限容器里 /proc、/dev 常是 bwrap 的第一个失败点；确认 harness 不依赖后可置 0
AO_SANDBOX_MOUNT_PROC=1
AO_SANDBOX_MOUNT_DEV=1

# 包仓库根目录
AO_PACKAGES_DIR=packages
